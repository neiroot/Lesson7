# По умолчанию данные и модели хранятся в ~/Library/Application Support/AI Meeting Analyzer.
# DATA_DIR=~/Library/Application Support/AI Meeting Analyzer/data
# MODEL_DIR=~/Library/Application Support/AI Meeting Analyzer/models
MAX_VIDEO_MIB=500
MAX_SAMPLE_MIB=50
MAX_SAMPLE_SECONDS=120
OLLAMA_NUM_CTX=8192
# OAuth-приложение с правом cloud_api:disk.read и callback
# http://127.0.0.1:8000/api/integrations/yandex/callback
# YANDEX_CLIENT_ID=
YANDEX_DISK_PATH=disk:/Видеовстречи
YANDEX_POLL_SECONDS=10
# Калибровка создаётся из отдельного локального набора. По умолчанию автоимена выключены.
# CALIBRATION_FILE=~/Library/Application Support/AI Meeting Analyzer/calibration.json
# MIN_RMS_DBFS=-38
# MAX_CLIPPING_RATIO=0.005
